{
  "name": "dsh-adb-ultimate",
  "version": "1.0.0",
  "description": "ADB Ultimate - 全功能ADB设备管理插件 for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "author": {
    "name": "Your Name",
    "email": "your.email@example.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourname/dsh-adb-ultimate.git"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "adb",
    "android",
    "mobile",
    "device-management"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "pack": "npm pack --dry-run"
  },
  "dependencies": {
    "schemastery": "^3.13.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=3.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
